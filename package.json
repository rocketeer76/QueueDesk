{
  "name": "queuedesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.5",
    "@astrojs/solid-js": "^7.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/astro": "^10.74.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-solid": "^0.18.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
